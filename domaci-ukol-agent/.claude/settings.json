{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["filesystem", "git", "github"],
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Skill",
      "Agent",
      "Bash(python3 -m unittest:*)",
      "Bash(bash dokumentace/overeni.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__filesystem",
      "mcp__git"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "mcp__github"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  }
}
